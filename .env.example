# HuntForge 环境变量示例（复制为 .env 后填入真实值；.env 不入库）
# 本地模式（HUNTFORGE_GATEWAY 未启用）直连以下地址；托管沙箱由平台注入。

# 答题平台（TSecBench；托管模式由平台自动注入，本地联调时填写）
BENCHMARK_BASE_URL=https://tsecbench.zc.tencent.com
BENCHMARK_TOKEN=your-benchmark-token-here

# 大模型密钥（任选其一；网关按 tier 配置读取）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# 备用网关（可选）
BAIDU_AWD_API_KEY=your-baidu-awd-key-here

# 模型上游（可选；默认 http://api.deepseek.com.tsecbench.gw/v1）
HF_LLM_BASE_URL=http://api.deepseek.com.tsecbench.gw/v1

# 托管网关（可选；沙箱内设 1）
HUNTFORGE_GATEWAY=0
